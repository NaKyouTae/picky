# ── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=21000

# CORS 허용 오리진 (쉼표 구분)
CORS_ORIGINS=http://localhost:21001,http://localhost:21002

# ── Supabase Postgres (Prisma) ─────────────────────────
# Transaction pooler (port 6543) — 런타임 쿼리용
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — migrate 용
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=change-me-in-production
# 서버 간 호출용 정적 토큰 (어드민 프론트의 ADMIN_TOKEN 과 동일해야 함)
ADMIN_TOKEN=change-me-admin-token

# 어드민 로그인 계정 (DB 아님 — 환경변수로 관리)
ADMIN_USERNAME=admin
ADMIN_PASSWORD='change-me-admin-password'

# ── 카카오 로그인 ──────────────────────────────────────
# 콘솔 선행 설정: [카카오 로그인] 활성화 + [OpenID Connect] 활성화(id_token 용),
# [동의항목]에서 닉네임·카카오계정(이메일) 사용 설정
# 카카오 developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# [카카오 로그인 > 보안]에서 Client Secret 을 '사용함'으로 켠 경우에만 필요
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 Redirect URI 와 문자 단위로 동일해야 함 (토큰 교환 시 함께 전송)
KAKAO_REDIRECT_URI=http://localhost:21001/auth/kakao/callback
# 탈퇴 시 카카오 연결 해제용 (developers.kakao.com > 앱 키 > Admin 키). 없으면 해제를 건너뛴다.
KAKAO_ADMIN_KEY=

# ── 네이버 로그인 ──────────────────────────────────────
# 콘솔 선행 설정: [API 설정]에서 '네이버 로그인' 사용 API 추가 +
# 제공 정보(회원이름·휴대전화번호 필수 / 이메일·성별·생일·출생연도 추가) 선택,
# [네이버 로그인 플러스]에 약관 4종 등록(service_/privacy_/third_party_/marketing_ 접두사)
# 네이버 developers > 내 애플리케이션 > 개요
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 콘솔 [로그인 오픈 API 서비스 환경]의 Callback URL 과 문자 단위로 동일해야 함
NAVER_REDIRECT_URI=http://localhost:21001/auth/naver/callback
# 탈퇴 시 연결 해제(grant_type=delete)는 사용자의 액세스 토큰을 요구한다. 그래서 로그인 때 받은
# 갱신 토큰을 accounts.refresh_token 에 암호화해 보관했다가 탈퇴 시점에 쓴다(아래 키로 암호화).

# ── 저장 토큰 암호화 ───────────────────────────────────
# accounts.refresh_token 을 AES-256-GCM 으로 암·복호화하는 비밀.
# 비워 두면 JWT_SECRET 을 대신 쓴다 — 운영에서는 따로 두는 편이 낫다.
# ⚠️ 값을 바꾸면 이미 저장된 토큰은 복호화되지 않아 네이버 연결 해제가 수동 안내로 떨어진다.
TOKEN_ENCRYPTION_KEY=

# ── 토스페이먼츠 ───────────────────────────────────────
# 개발자센터 > 내 개발정보 > API 키 의 '시크릿 키' (test_sk_… / live_sk_…)
# 결제 승인은 반드시 서버에서 이 키로 호출한다 — 절대 프론트에 노출하지 않는다.
TOSS_SECRET_KEY=

# ── Cloudtype ──────────────────────────────────────────
# 배포 시 Cloudtype 콘솔의 환경변수 탭에 위 값들을 등록합니다.
