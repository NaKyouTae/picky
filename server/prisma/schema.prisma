// Prisma 7 schema — Supabase PostgreSQL
// 연결 URL 은 prisma.config.ts(마이그레이션) / PrismaService(런타임 어댑터)에서 관리합니다.
// docs: https://www.prisma.io/docs

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// SNS 로그인 제공자
enum ProviderType {
  KAKAO
  NAVER
  /// Sign in with Apple — 소셜 로그인만 제공하는 앱은 애플이 함께 요구한다 (App Store 심사 4.8)
  APPLE
}

/// 동의 항목 — 필수(이용약관·개인정보 수집·이용)와 선택(마케팅 정보 수신·제3자 제공)
enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
  THIRD_PARTY
}

/// 동의를 어디서 받았는지.
///
/// SELF 는 우리 화면(로그인 고지·마이페이지 토글·약관 화면의 동의 바)에서 받은 것이고,
/// 나머지는 SNS 간편가입 동의화면에서 받아 온 것이다.
/// 카카오만 약관 동의 내역을 API 로 돌려준다 — 그 API 가 없는 제공자는 SELF 로만 기록된다.
enum ConsentSource {
  SELF
  KAKAO
  NAVER
}

/// 챌린지 노출 상태 — PUBLISHED 만 앱의 랜덤 추첨 대상이 된다
enum ChallengeStatus {
  /// 작성 중 (앱에 노출 안 됨)
  DRAFT
  /// 공개
  PUBLISHED
  /// 보관 (더 이상 뽑히지 않음)
  ARCHIVED
}

/// 챌린지 그룹 상태 — 상태·일자는 그룹 단위로만 관리한다
enum ChallengeGroupStatus {
  /// 진행 중 — 사용자·카테고리당 하나만 존재한다 (카테고리가 다르면 동시에 진행할 수 있다)
  IN_PROGRESS
  /// 완료 (끝까지 해냄)
  COMPLETED
  /// 종료 (완료하지 않고 그만둠)
  ENDED
}

model User {
  id       String    @id @default(uuid()) @db.Uuid
  /// 선택 — SNS 프로필에서 수집. 카카오·네이버 모두 **선택 동의**라 거부하면 비어 있다.
  ///
  /// **unique 가 아니다.** 회원을 묶는 기준은 email 이 아니라 phone 이다 —
  /// 제공자가 주는 이메일은 신뢰도가 제각각이라(네이버는 검증되지 않은 연락처 이메일)
  /// 이것으로 계정을 합치면 남의 주소를 적어 넣는 것만으로 계정을 가로챌 수 있다.
  email    String?
  /// 필수 — 카카오·네이버 모두 필수 동의로 받으므로 항상 채워진다.
  name     String
  /// SNS 프로필에서 받은 연락처 — 숫자만 (예: "01012345678").
  ///
  /// **회원을 묶는 기준이다.** 제공자가 다르더라도 번호가 같으면 같은 사람으로 보고
  /// 한 회원에 계정을 덧붙인다 (User 1 : N Account). 카카오·네이버 모두 필수 동의로 받고
  /// 통신사에서 본인확인된 번호라, 성격이 제각각인 이메일보다 믿을 수 있다.
  ///
  /// 그래서 unique 다 — 같은 번호로 회원이 둘 생기면 식별 기준이 무너진다.
  /// 번호를 받지 못하면(해외 번호·동의 거부) null 이고, 그때는 묶을 근거가 없어 별도 회원이 된다.
  /// Postgres 는 NULL 중복을 허용하므로 제약은 그대로 유지된다.
  /// 탈퇴하면 null 로 비우므로(개인정보 파기) 그 번호로 다시 가입할 수 있다.
  phone    String?   @unique @db.VarChar(20)
  /// 선택 — 제공자가 동의를 받지 못하면 비어 있음
  gender   Gender?
  /// "20~29" 처럼 제공자마다 표기가 달라 문자열로 보관
  ageRange String?   @map("age_range") @db.VarChar(20)
  birthday DateTime? @db.Date

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  /// 동의 시각 — null 이면 미동의(또는 철회). 필수 동의는 가입 시 기록한다.
  termsAgreedAt      DateTime? @map("terms_agreed_at")
  privacyAgreedAt    DateTime? @map("privacy_agreed_at")
  marketingAgreedAt  DateTime? @map("marketing_agreed_at")
  /// 마케팅 동의 만료일 (개인정보보호법 시행령 §48조의2 — 2년마다 재확인).
  /// 지나면 동의가 살아 있다고 보지 않고 재동의를 받아야 한다.
  marketingExpiresAt DateTime? @map("marketing_expires_at")
  thirdPartyAgreedAt DateTime? @map("third_party_agreed_at")

  /// 위 동의 시각을 어디서 받았는지 — 마이페이지에 "카카오에서 동의" 로 보여 준다.
  /// 이력은 consent_logs 가 들고 있고, 여기에는 최신 한 건의 출처만 둔다 (동의 시각과 짝).
  termsConsentSource      ConsentSource? @map("terms_consent_source")
  privacyConsentSource    ConsentSource? @map("privacy_consent_source")
  marketingConsentSource  ConsentSource? @map("marketing_consent_source")
  thirdPartyConsentSource ConsentSource? @map("third_party_consent_source")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts         Account[]
  challengeGroups  ChallengeGroup[]
  collages         Collage[]
  consentLogs      ConsentLog[]
  membershipOrders MembershipOrder[]

  // 목록/통계 조회용
  @@index([status, createdAt])
  @@index([createdAt])
  // 어드민에서 이메일로 회원을 찾을 때 (email 은 unique 가 아니라 인덱스만 둔다.
  // 연락처는 위 @unique 가 인덱스를 겸한다)
  @@index([email])
  @@map("users")
}

/// SNS 계정 — 한 유저가 여러 제공자를 동시에 연결할 수 있음 (User 1 : N Account)
model Account {
  id String @id @default(uuid()) @db.Uuid

  userId       String       @map("user_id") @db.Uuid
  providerType ProviderType @map("provider_type")
  /// 제공자가 발급한 고유 회원번호 (카카오 id 등)
  providerId   String       @map("provider_id") @db.VarChar(255)
  /// 탈퇴 시 제공자 쪽 연결을 끊는 데 쓰는 갱신 토큰 — AES-256-GCM 으로 암호화해 보관한다.
  /// 네이버의 연결 해제 API 가 그 사용자의 토큰을 요구해서 어쩔 수 없이 들고 있는 값이다.
  /// 카카오는 어드민 키만으로 끊을 수 있어 저장하지 않는다(늘 null).
  /// 암호문 길이는 토큰 길이에 딸려 가므로 상한을 두지 않는다.
  refreshToken String?      @map("refresh_token") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 로그인 시 (제공자, 제공자 회원번호) 로 단건 조회 — 중복 연결 방지까지 겸함
  @@unique([providerType, providerId])
  // 한 유저가 같은 제공자를 두 번 연결하지 못하도록
  @@unique([userId, providerType])
  // FK 는 Postgres 가 자동 인덱싱하지 않음. 유저의 연결 계정 조회/삭제 성능용
  @@index([userId])
  @@map("accounts")
}

/// 동의·철회 이력 — append-only. users 에는 최신 동의 시각만 남으므로
/// 언제 무엇에 동의하고 철회했는지는 이 표로만 증빙할 수 있다.
model ConsentLog {
  id String @id @default(uuid()) @db.Uuid

  userId      String        @map("user_id") @db.Uuid
  type        ConsentType
  /// true = 동의, false = 철회
  agreed      Boolean
  /// 이 한 건을 어디서 받았는지 (우리 화면 / SNS 간편가입 동의화면)
  source      ConsentSource @default(SELF)
  /// SNS 에서 받아 온 경우 그 제공자의 약관 태그 (예: service_20260921).
  /// 약관을 개정하면 태그가 바뀌므로, 어떤 판본에 동의했는지는 이 값으로만 증빙된다.
  providerTag String?       @map("provider_tag") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 사용자의 항목별 최신 이력 조회: WHERE (user_id, type) ORDER BY created_at desc
  @@index([userId, type, createdAt])
  @@map("consent_logs")
}

/// 관리자가 등록하는 챌린지. 앱에서는 카테고리를 고른 뒤 PUBLISHED 중 하나가 랜덤으로 뽑힌다.
model Challenge {
  id String @id @default(uuid()) @db.Uuid

  categoryId String          @map("category_id") @db.Uuid
  status     ChallengeStatus @default(DRAFT)

  /// 카드에 크게 보이는 한 줄 (예: "서로 좋아하는 영화 바꿔 시청하기")
  title       String  @db.VarChar(120)
  /// 상세 설명 — 어떻게 진행하는지
  description String? @db.Text
  /// 소요 시간 안내 (예: "2시간", "하루") — 자유 문구
  duration    String? @db.VarChar(40)
  /// 카드 상단 이모지 (예: "🎬")
  emoji       String? @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category   ChallengeCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  groupItems ChallengeGroupItem[]

  // 앱 랜덤 추첨: WHERE (category_id, status) — 선행 컬럼부터 조건에 그대로 쓰인다
  @@index([categoryId, status])
  // 어드민 목록: WHERE status + ORDER BY createdAt desc
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("challenges")
}

/// 관리자가 등록하는 챌린지 카테고리 (예: 혼자 / 둘이서 / 아이랑).
/// 앱 메인 화면에 PUBLISHED 카테고리가 display_order 순서로 나열된다.
model ChallengeCategory {
  id String @id @default(uuid()) @db.Uuid

  /// 화면에 보이는 이름 (예: "둘이서")
  name        String  @db.VarChar(40)
  /// 카드 위 이모지 (예: "💞")
  emoji       String? @db.VarChar(8)
  /// 한 줄 설명 (예: "늘 하던 데이트 말고")
  description String? @db.VarChar(120)

  /// 챌린지와 같은 노출 상태를 쓴다 — PUBLISHED 만 앱에 보인다
  status       ChallengeStatus @default(PUBLISHED)
  /// 앱 목록 정렬 — 작을수록 앞에 보인다
  displayOrder Int             @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  challenges Challenge[]
  groups     ChallengeGroup[]

  // 앱 목록: WHERE status ORDER BY display_order, name — 선행 컬럼부터 그대로 쓰인다
  @@index([status, displayOrder, name])
  @@index([createdAt])
  @@map("challenge_categories")
}

/// 챌린지 그룹 — 카테고리를 고르면 하나 생성되고, 챌린지가 하나씩 최대 5개까지 담긴다.
/// 상태·일자는 이 그룹 단위로만 기록한다 (개별 챌린지는 상태를 갖지 않는다).
model ChallengeGroup {
  id String @id @default(uuid()) @db.Uuid

  userId     String @map("user_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  status ChallengeGroupStatus @default(IN_PROGRESS)

  /// 시작 시각 — 카테고리를 고른 시점
  startedAt   DateTime  @default(now()) @map("started_at")
  /// 완료하지 않고 그만둔 시각
  endedAt     DateTime? @map("ended_at")
  /// 완료한 시각
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ChallengeCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items    ChallengeGroupItem[]
  /// 완성해서 보관한 콜라주 (등급 무관 — 아래 Collage 참고)
  collage  Collage?

  // 메인 화면: 진행 중인 그룹 전부 조회 WHERE (user_id, status) — 선행 컬럼부터 그대로 쓰인다
  @@index([userId, status])
  // 카테고리를 고를 때: 그 카테고리의 진행 중 그룹이 있는지 WHERE (user_id, category_id, status)
  @@index([userId, categoryId, status])
  // 사용자별 기록 목록: WHERE user_id ORDER BY created_at desc
  @@index([userId, createdAt])
  // FK 는 Postgres 가 자동 인덱싱하지 않는다
  @@index([categoryId])
  @@map("challenge_groups")
}

/// 그룹의 챌린지 한 칸 (최대 5칸 — 개수 제한은 서비스에서 확인한다).
///
/// 칸은 완료할 때만 늘어난다. '다시 뽑기' 는 새 칸을 만들지 않고 현재 칸의 challengeId 만 바꾼다.
model ChallengeGroupItem {
  id String @id @default(uuid()) @db.Uuid

  groupId        String    @map("group_id") @db.Uuid
  /// 다시 뽑기로 교체될 수 있다 — position 은 그대로 두고 이 값만 바뀐다
  challengeId    String    @map("challenge_id") @db.Uuid
  /// 그룹 안 몇 번째 칸인지 (1..5)
  position       Int
  /// 이 칸을 완료한 시각 — null 이면 아직 진행 중인 칸이다.
  /// 완료하면 다음 칸이 새로 뽑히고, 마지막 칸을 완료하면 그룹이 완료된다.
  completedAt    DateTime? @map("completed_at")
  /// 인증 사진의 Storage 경로 (private 버킷 `challenge-proofs`).
  ///
  /// **임시 파일이다.** 콜라주를 만든 뒤 또는 그룹을 그만둘 때 파일과 함께 이 값도 비운다.
  /// public URL 은 만들지 않고 필요할 때 signed URL 을 발급한다.
  proofImagePath String?   @map("proof_image_path") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group     ChallengeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  challenge Challenge      @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  // 같은 챌린지가 한 그룹에 두 번 들어가지 않게 (= 이미 나온 건 다시 안 뽑힘)
  @@unique([groupId, challengeId])
  // 순서 중복 방지 + 그룹의 챌린지를 순서대로 읽는 조회를 커버한다
  @@unique([groupId, position])
  // FK 는 Postgres 가 자동 인덱싱하지 않는다
  @@index([challengeId])
  @@map("challenge_group_items")
}

/// 완성해서 보관한 콜라주 (private 버킷 `collages`).
///
/// **콜라주를 완성하면 회원 등급을 가리지 않고 남는다.** 유료·무료를 나누는 곳은 여기가 아니라
/// '완료한 챌린지' 에서 **다시 받을 때**다 — 그 시점에 회원권이 살아 있어야 한다.
///
/// 인증 사진(`challenge_group_items.proof_image_path`)과 성격이 반대다. 그쪽은 콜라주를
/// 만들면 지우는 임시 파일이고, 이쪽은 '완료한 챌린지' 에서 다시 내려받을 결과물이다.
///
/// 그룹당 한 장이다 (`@@unique([groupId])`) — 템플릿을 바꿔 다시 내려받으면 마지막 것으로
/// 갈아 끼우고 이전 파일은 Storage 에서 지운다. 그렇게 하지 않으면 내려받을 때마다 파일이 쌓인다.
///
/// 기간이 끝나면 파일은 그대로 두고 내려받기만 막는다 — 다시 구매하면 예전 콜라주가 돌아온다.
model Collage {
  id String @id @default(uuid()) @db.Uuid

  userId  String @map("user_id") @db.Uuid
  /// 어느 챌린지 그룹으로 만든 콜라주인지 — '완료한 챌린지' 목록이 이 값으로 붙인다
  groupId String @map("group_id") @db.Uuid

  /// Storage 경로 — private 버킷이라 public URL 을 만들지 않고 필요할 때 signed URL 을 발급한다
  imagePath String @map("image_path") @db.VarChar(500)
  /// 파일 크기 (바이트) — 보관량을 확인할 때 쓴다
  byteSize  Int    @map("byte_size")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group ChallengeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // 그룹당 한 장 — 다시 내려받으면 갈아 끼운다. 그룹으로 찾는 단건 조회도 이 제약이 커버한다
  @@unique([groupId])
  // 내 보관함 목록: WHERE user_id ORDER BY created_at desc
  @@index([userId, createdAt])
  @@map("collages")
}

/// 스티커 템플릿 노출 상태 — PUBLISHED 만 앱 목록에 보인다
enum StickerTemplateStatus {
  /// 작성 중 (앱에 노출 안 됨)
  DRAFT
  /// 공개
  PUBLISHED
  /// 보관 (더 이상 노출되지 않음)
  ARCHIVED
}

/// 관리자가 등록하는 사진 콜라주 템플릿.
/// 이미지 한 장 + 사진이 들어갈 칸 목록으로 이루어진다.
model StickerTemplate {
  id String @id @default(uuid()) @db.Uuid

  title  String                @db.VarChar(120)
  status StickerTemplateStatus @default(DRAFT)

  /// 템플릿 이미지 public URL — **사진 자리가 투명하게 뚫린 합성용 레이어**다.
  imageUrl  String @map("image_url") @db.Text
  /// Storage 내부 경로 — 이미지 교체/삭제 시 이전 파일을 지우는 데 쓴다
  imagePath String @map("image_path") @db.VarChar(500)

  /// 고객에게 보여 줄 미리보기 이미지 (앱의 템플릿 선택 바텀시트).
  ///
  /// 합성용 레이어는 칸이 뚫려 있어서, 칸이 화면 전체인 템플릿은 **전부 투명한 PNG** 가 된다.
  /// 그대로 보여 주면 빈 카드로 보이므로 칸을 회색으로 채운 그림을 따로 만들어 둔다.
  /// 이 값이 없으면(예전에 등록한 템플릿) 앱은 imageUrl 로 되돌아간다.
  previewImageUrl  String? @map("preview_image_url") @db.Text
  previewImagePath String? @map("preview_image_path") @db.VarChar(500)
  /// 원본 픽셀 크기 — 목록 썸네일의 비율을 잡는 데 쓴다
  imageWidth       Int     @map("image_width")
  imageHeight      Int     @map("image_height")

  /// 사진이 들어갈 칸 — 템플릿 원본 픽셀 기준 `[{ cx, cy, w, h, angle }]` (angle 은 라디안).
  /// 0~1 로 정규화하지 않는다: 회전이 있으면 x·y 를 각각 다른 값으로 나누는 순간 각도가 뒤틀린다.
  slots     Json @default("[]")
  /// slots 의 길이. 목록에서 칸 수를 보여주고 필터하려고 따로 둔다 (JSON 안을 세지 않기 위해).
  slotCount Int  @default(0) @map("slot_count")

  /// 유료 템플릿 여부 — true 면 결제(또는 구독)한 사용자만 쓸 수 있다.
  /// 기존/신규 템플릿은 무료가 기본이고, 어드민 콜라주 수정 화면에서 바꾼다.
  isPaid Boolean @default(false) @map("is_paid")

  /// 앱 목록 정렬 — 작을수록 앞에 보인다
  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 앱 목록: WHERE status ORDER BY display_order, created_at — 선행 컬럼부터 그대로 쓰인다
  @@index([status, displayOrder, createdAt])
  // 어드민 목록: WHERE status + ORDER BY created_at desc
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("sticker_templates")
}

/// 유료 템플릿을 쓸 수 있는 기간권(회원권).
/// 관리자가 "개월 수 + 금액" 으로 수시로 만들고, 구매하면 그 개월 수만큼 이용 기간이 늘어난다.
/// 구매 기록은 별도 테이블에서 이 플랜을 참조한다 (금액·개월 수는 구매 시점 값을 복사해 둘 것 —
/// 플랜의 가격이 나중에 바뀌어도 지난 구매가 흔들리지 않게).
model MembershipPlan {
  id String @id @default(uuid()) @db.Uuid

  /// 앱 결제 화면에 보이는 이름 (예: 1개월권)
  name        String  @db.VarChar(60)
  /// 구매 시 늘어나는 이용 기간 (개월)
  months      Int
  /// 판매 금액 = 실제로 청구되는 금액 — KRW 원 단위 정수 (소수점 없는 통화라 Decimal 을 쓰지 않는다).
  /// 할인 중이면 이 값이 할인가다 (할인 전 금액은 아래 list_price).
  price       Int
  /// 할인 전 정가 (원). 결제 화면에서 판매 금액 옆에 취소선으로 함께 보여 준다.
  ///
  /// **청구 금액이 아니다** — 주문 금액은 언제나 `price` 다. 할인 중이 아니면 비워 둔다
  /// (`price` 보다 큰 값만 의미가 있어서, 어드민이 그보다 작거나 같은 값을 넣으면 거절한다).
  listPrice   Int?    @map("list_price")
  /// 결제 화면에 덧붙이는 한 줄 설명
  description String? @db.VarChar(200)

  /// App Store Connect 에 등록한 인앱결제 상품 ID (비갱신 구독).
  ///
  /// iOS 앱은 이 값으로 StoreKit 에서 상품을 찾는다. 비어 있으면 앱 결제 화면에서 이 회원권을
  /// 감춘다 — 상품이 없으면 살 수 없기 때문이다. 웹(토스) 결제는 이 값과 무관하게 동작한다.
  appleProductId String? @unique @map("apple_product_id") @db.VarChar(120)

  /// 판매 여부 — false 면 앱 결제 화면에서 감춘다.
  /// 이미 판매한 회원권의 남은 기간에는 영향이 없다 (기간은 구매 기록이 들고 있다).
  isActive Boolean @default(true) @map("is_active")

  /// 앱 목록 정렬 — 작을수록 앞에 보인다
  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders MembershipOrder[]

  // 앱 결제 화면: WHERE is_active ORDER BY display_order, months — 선행 컬럼부터 그대로 쓰인다
  @@index([isActive, displayOrder, months])
  @@map("membership_plans")
}

/// 결제를 처리한 스토어.
///
/// iOS 앱 안에서 열리는 유료 템플릿은 외부 결제로 팔 수 없어(App Review Guideline 3.1.1)
/// 앱에서는 App Store 인앱결제만 쓴다. 웹 브라우저는 그대로 토스페이먼츠를 쓴다.
/// 환불 창구가 스토어마다 달라서(토스=우리, App Store=Apple) 내역에 남겨야 한다.
enum MembershipStore {
  /// 웹 브라우저 — 토스페이먼츠 결제창
  WEB
  /// iOS 앱 — App Store 인앱결제
  APPLE
}

/// 회원권 결제 상태.
enum MembershipOrderStatus {
  /// 주문을 만들고 결제창을 띄운 상태 (아직 승인 안 됨)
  PENDING
  /// 결제 승인 완료 — 이용 기간이 부여된다
  PAID
  /// 결제창에서 실패·중단됐거나 승인이 거절된 상태
  FAILED
  /// 환불되어 이용 기간이 회수된 상태.
  ///
  /// 지금은 App Store 환불(App Store Server Notifications 의 REFUND)만 이 상태가 된다 —
  /// 토스 결제 환불은 고객센터에서 수동 처리하므로 아직 자동으로 넘어오지 않는다.
  REFUNDED
}

/// 회원권 결제(구매) 내역.
///
/// 토스페이먼츠 결제창 흐름: 주문 생성(PENDING) → 결제창 → successUrl → 서버 승인(confirm) → PAID.
/// 이용 기간은 승인 시점에 계산해 `startsAt`~`endsAt` 로 굳힌다. 남은 기간이 있으면 그 뒤에 이어 붙이므로
/// "유료 템플릿을 쓸 수 있는가" 는 이 테이블에서 endsAt 최댓값만 보면 된다 (별도 이용권 테이블을 두지 않는다).
model MembershipOrder {
  id String @id @default(uuid()) @db.Uuid

  /// 토스에 넘기는 주문번호 — 승인·조회의 키라서 우리가 만들고 유일해야 한다
  orderCode String @unique @map("order_code") @db.VarChar(64)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 구매한 회원권. 플랜이 지워져도 결제 내역은 남아야 하므로 SetNull 이고,
  /// 화면에 보여 줄 값은 아래 스냅샷을 쓴다.
  planId String?         @map("plan_id") @db.Uuid
  plan   MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  /// 구매 시점 스냅샷 — 플랜의 이름·금액·기간이 나중에 바뀌어도 지난 내역은 그대로여야 한다
  planName String @map("plan_name") @db.VarChar(60)
  months   Int
  /// 결제 금액 (원) — 승인 시 토스가 알려준 금액과 일치해야 한다
  amount   Int

  status MembershipOrderStatus @default(PENDING)

  /// 어느 스토어에서 결제했는지. 기존 주문은 전부 토스라 기본값이 WEB 이다.
  store MembershipStore @default(WEB)

  /// App Store 거래 ID (`transactionId`) — APPLE 주문에만 있다.
  ///
  /// **같은 거래로 이용 기간이 두 번 늘어나지 않게 막는 멱등 키다.** 앱이 영수증을 두 번
  /// 보내거나(재시도·복원) 네트워크가 끊겨 다시 보내도 이 unique 제약이 중복 적립을 막는다.
  appleTransactionId String? @unique @map("apple_transaction_id") @db.VarChar(64)

  /// 같은 상품 계열의 첫 거래 ID (`originalTransactionId`).
  /// 환불·고객 문의를 Apple 에 조회할 때 기준이 되는 값이라 함께 남긴다.
  appleOriginalTransactionId String? @map("apple_original_transaction_id") @db.VarChar(64)

  /// 토스 결제 식별자 — 승인 후에 생긴다 (WEB 주문 전용)
  paymentKey String?   @unique @map("payment_key") @db.VarChar(200)
  /// 토스가 알려주는 결제수단 표기 (카드, 간편결제 등)
  method     String?   @db.VarChar(40)
  paidAt     DateTime? @map("paid_at")
  /// 실패 사유 (토스 code: message) — 내역 화면에 이유를 보여주기 위해 남긴다
  failReason String?   @map("fail_reason") @db.VarChar(300)

  /// 환불 시각 — REFUNDED 일 때만 채워진다 (Apple 이 알려 준 revocationDate)
  refundedAt DateTime? @map("refunded_at")

  /// 부여된 이용 기간 — PAID 일 때만 채워진다
  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 마이페이지 결제 내역: WHERE user_id ORDER BY created_at desc
  @@index([userId, createdAt])
  // 이용권 유효 여부: WHERE user_id AND status = PAID AND ends_at > now()
  @@index([userId, status, endsAt])
  // 어드민 목록: WHERE status? ORDER BY created_at desc
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("membership_orders")
}
