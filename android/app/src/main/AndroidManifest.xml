<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 콜라주를 갤러리에 담을 때만 쓴다. Android 10(API 29)부터는 MediaStore 에 자기가 만든
         항목을 넣는 데 권한이 필요 없으므로 9 이하로 제한한다 (ImageSaver.kt). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 챌린지 인증 사진 (Phase 2 에서 실제로 쓴다) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 웹이 여는 외부 앱을 확인하려면 API 30+ 에서 조회 대상을 선언해야 한다.
         선언하지 않으면 카카오톡·카드사 앱이 깔려 있어도 '없음' 으로 보인다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- 인증 사진 촬영 — 이게 없으면 카메라 앱이 깔려 있어도 못 찾는다 -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Picky.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|navigation|touchscreen|layoutDirection">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 카드사 앱카드에서 돌아올 때 쓰는 앱 스킴.
                 iOS 의 Info.plist CFBundleURLSchemes 와 **같은 문자열이어야** 한다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="picky" />
            </intent-filter>
        </activity>

        <!-- 촬영본을 카메라 앱에 넘길 때 쓰는 content:// 주소.
             API 24+ 는 file:// 을 앱 밖으로 넘기면 FileUriExposedException 으로 죽는다.
             경로는 res/xml/file_paths.xml. (FileChooser.kt) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
